    <style>
        .thinking-splash {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.8);
            }

            .thinking-box {
            padding: 1.5rem 2rem;
            text-align: center;
            background: white;
            border-radius: 0.5rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.2);
            font-size: 1.25rem;
            color: #333;
            }

            .d-none {
            display: none !important;
            }

            .w-30 {
            width: 30%;
            }

            @media (max-width: 768px) {
                .w-30 {
                    width: 100%;
                }
            }

            #requestorRequestorSignDiv {
                background-color: transparent;
                border-color: transparent;
                color: inherit;
            }

            .success-flash {
                animation: successFlash 5s ease-in-out forwards;
            }

            @keyframes successFlash {
                0% {
                    background-color: transparent;
                    border-color: transparent;
                    color: inherit;
                }

                25%,
                65% {
                    background-color: #d1e7dd; /* Bootstrap alert-success background */
                    border-color: #a3cfbb;
                    color: #0f5132;             /* Bootstrap alert-success text */
                }

                100% {
                    background-color: transparent;
                    border-color: transparent;
                    color: inherit;
                }
            }
