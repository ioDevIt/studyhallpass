    <script>
        const alertModalElement = document.getElementById("alertModal")
        const alertModalTitle = document.getElementById('alertModalTitle')
        const alertModalMessage = document.getElementById('alertModalMessage')
        const alertModal = bootstrap.Modal.getOrCreateInstance(alertModalElement)


        // const alertModal = document.getElementById('alertModal')
        const splash = document.getElementById("thinkingSplash")
        const thinkingText = document.getElementById("thinkingText")
        const nameTxt=document.getElementById('nameTxt')
        const gradeSpan=document.getElementById('gradeSpan')
        const toReportOnDate = document.getElementById('toReportOnDate')
        const periodTable = document.getElementById('periodTable')
        const periodTableBody = document.getElementById('periodTableBody')
        const atPeriodSpan = document.getElementById('atPeriodSpan')
        const atClintRecId = document.getElementById('atClintRecId')
        const fromTime = document.getElementById('fromTime')
        const fromAll = document.getElementById('fromAll')
        const destinationTxt = document.getElementById('destinationTxt')
        const reasonTxtArea = document.getElementById('reasonTxtArea')


        const requestorSignDiv = document.getElementById('requestorSignDiv')
        const requestorSignSpan = document.getElementById('requestorSignSpan')
        const requestorSignDateSpan = document.getElementById('requestorSignDateSpan')
        const requestorBtn = document.getElementById('requestorBtn')
        const currentUserSpan= document.getElementById('currentUserSpan')
        const requestorRequestorSignDiv =  document.getElementById('requestorRequestorSignDiv')
        
        const thisCurrentStudent={id:<%= data.stud_id %>,grade:<%= data.grade %>};
        const gradeBracketRegex = /\[(\d{1,2})\]/
        const periodTextDefault = '[Select Period From Table]'

        const mainStartingWord ='thinking'
        const startingWordArray = 'eating'
        // let currentSelectionList={};


        const sendPassData=()=>{
          const packageData={name:nameTxt.value
            ,grade:gradeSpan.textContent
            ,onDate:toReportOnDate.value
            ,atPeriod:atPeriodSpan.textContent
            ,atClintRecId:atClintRecId.textContent
            ,duration:(fromAll.checked?'A':fromTime.value)
            ,reportTo:destinationTxt.value
            ,reason:reasonTxtArea.value

            ,passId:currentPassTicketIdSpan.textContent
          }

          const postid="?"
          const rsConfig={headers:{"X-XSRF-TOKEN":postid},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

          console.log('packageData',packageData)

          axios.post('/updateEditPass',{
            packageData,
            postid:postid
          },rsConfig).then((rsp)=>{
            console.log('rsp',rsp)
            const rspData = rsp.data

            console.log('rspData',rspData)

            if(('returnDisplay' in rspData) && (rspData.returnDisplay.bywho!=='')){
                requestorSignSpan.textContent=rspData.returnDisplay.bywho
                requestorSignDateSpan.textContent=rspData.returnDisplay.updatedatetimeDisplay
                requestorRequestorSignDiv.classList.remove('d-none')
                requestorRequestorSignDiv.classList.add('success-flash')
                disableElements()
            }
            else{
                showAlertModal("Error","Please Check Fields")
            }
            
            // setNewValues(rspData)
          })
          .catch((e)=>{console.log(e)})
        }


        nameTxt.addEventListener('keyup',(e)=>{
          let thiskeyCode = nameTxt.value;
          const postid="?"
          const rsConfig={headers:{"X-XSRF-TOKEN":postid},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

          console.log('thiskeyCode',thiskeyCode)
          axios.post('/getPassStudentList',{
            search:thiskeyCode,
            postid:postid
          },rsConfig).then((rsp)=>{
            console.log('rsp',rsp)
            const rspData = rsp.data

            console.log('rspData',rspData)
            
            setNewValues(rspData)
          })
          .catch((e)=>{console.log(e)})
        })

        nameTxt.addEventListener('change',()=>{
            const thisValueArray = nameTxt.value.split('-')
            // const toFindId = (thisValueArray.length===2?thisValueArray[1].trim():'')
            const toFindGrade = nameTxt.value.match(gradeBracketRegex)
            // console.log(nameTxt.value.match(gradeBracketRegex))
            thisCurrentStudent.id=(thisValueArray.length===2?thisValueArray[1].trim():'')
            thisCurrentStudent.grade= (toFindGrade.length===2?toFindGrade[1]:'')
            console.log('thisValueArray',thisValueArray)
            console.log('thisCurrentStudent',thisCurrentStudent)

            hideClearPeriodTable()

            gradeSpan.textContent=thisCurrentStudent.grade

            requestorSignDiv.hidden=!allFieldsOk()
        })

        toReportOnDate.addEventListener('change',(e)=>{
          const thisDate = e.target.value
          console.log(thisDate)
            if(thisDate!==''){
                getSHPeriodsForStudent(thisDate,thisCurrentStudent)
                atPeriodSpan.textContent=periodTextDefault
                fromTime.value=''
                fromAll.value=''

                requestorSignDiv.hidden=!allFieldsOk()
            }else{
                atPeriodSpan.textContent=periodTextDefault
                fromTime.value=''
                fromAll.value=''
                initSettings()
            }
        })

        toReportOnDate.addEventListener('input',(e)=>{
          const thisDate = e.target.value
          console.log(thisDate)
            if(thisDate!==''){
                getSHPeriodsForStudent(thisDate,thisCurrentStudent)
                atPeriodSpan.textContent=periodTextDefault
                requestorSignDiv.hidden=!allFieldsOk()
            }else{
                initSettings()
            }
        })

        fromTime.addEventListener('change',(e)=>{
            clearFromAll()
            requestorSignDiv.hidden=!allFieldsOk()
            validateTimeSelected(e)
        })

        fromTime.addEventListener('input',(e)=>{
            clearFromAll()
            console.log('Will check on requestorSignDiv.hidden=!allFieldsOk()')
            requestorSignDiv.hidden=!allFieldsOk()
            validateTimeSelected(e)
        })


        fromAll.addEventListener('change',(e)=>{
            clearFromTime()
            requestorSignDiv.hidden=!allFieldsOk()
        })
        
        reasonTxtArea.addEventListener('input',(e)=>{
            requestorSignDiv.hidden=!allFieldsOk()
        })

        destinationTxt.addEventListener('input',(e)=>{
            requestorSignDiv.hidden=!allFieldsOk()
        })

        requestorBtn.addEventListener('click',(e)=>{
            if(allFieldsOk){
                requestorBtn.hidden=true // uncomment for prod
                sendPassData()
            }
            else{
                showAlertModal("Invalid Fields",`Please check fields`)
            }
        })

        const setNewValues=(theseValues)=>{
          const currentSelectionList = {}
          nameTxtList.innerHTML="";

          theseValues.forEach((thisRow)=>{
            console.log('thisRow',thisRow)
            let newEl=document.createElement('option')
            newEl.value =  `${thisRow.lname}, ${thisRow.pname} [${thisRow.grade}] - ${thisRow.id}`
            // newEl.textContent = thisRow.lname
            newEl.dataset.uid = thisRow.uid
            currentSelectionList[thisRow.uid]=thisRow

            nameTxtList.append(newEl)
          })
        }


        const getSHPeriodsForStudent=(thisDate,studentInfo)=>{
            // check thisDate, studentInfo
            // disable name search and date search

            // after response comes back
            // enable name search and date search

                showThinking()

                const postid="?"
                const rsConfig={headers:{"X-XSRF-TOKEN":postid},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

                console.log({         studentInfo:thisCurrentStudent,
                    postid:postid})
                axios.post('/getSHPeriods',{
                    search:thisDate,
                    studentInfo:thisCurrentStudent,
                    postid:postid
                },rsConfig).then((rsp)=>{                   
                    const rspData = rsp.data

                    console.log('rsp',rsp)
                    console.log('rspData',rspData)

                    setTable(periodTableBody,rspData)
                    showTable()
                    allFieldsOk()
                })
                .catch((e)=>{console.log(e);hideThinking()})
                .finally(()=>{
                    hideThinking()
                })

        }
        
    </script>

    <script>
        let thinkingTimer;        

        const showThinking = (startingWord,numofPauseDots) => {
        const thisStartingWord = (startingWord?startingWord:'thinking')
        const thisNumOfPauseDots = (numofPauseDots?numofPauseDots:6)
        let thinkingDots = 0
        splash.classList.remove("d-none");

        thinkingDots = 0;
        thinkingText.textContent = thisStartingWord;

        thinkingTimer = setInterval(() => {
            thinkingDots = (thinkingDots + 1) % thisNumOfPauseDots;
            thinkingText.textContent = `${thisStartingWord}${".".repeat(thinkingDots)}`;
        }, 500);
        };

        const hideThinking = () => {
        clearInterval(thinkingTimer);
        splash.classList.add("d-none");
        };

        const clearRowHighLights= () =>{
            const thisClassName='table-warning'
            const theseRows = document.getElementsByClassName(thisClassName)

            for(let i=0;i<theseRows.length;i++){theseRows[i].classList.remove(thisClassName)}
        }

        const setTable=(thisTableBody,thisData)=>{
            console.log('thisTableBody',thisTableBody.id)
            thisTableBody.replaceChildren()

            thisData.forEach((rowData)=>{
                const thisRw = document.createElement('tr')
                thisRw.id =`rowP_${rowData.period}`
                thisRw.addEventListener('click',(e)=>{
                    atPeriodSpan.textContent=rowData.period
                    atClintRecId.textContent=rowData.clint
                    requestorSignDiv.hidden=!allFieldsOk()
                    clearRowHighLights()
                    e.currentTarget.classList.add('table-warning')
                    setTimeLimitsOnTimePicker(rowData.start,rowData.end)
                })

                for(const [key,value] of Object.entries(rowData)){
                    const thisCellData = document.createElement('td')
                    thisCellData.textContent=value

                    thisRw.append(thisCellData)
                }

                thisTableBody.append(thisRw)
            })
        }

        const hideTable=()=>{
            periodTable.style.display='none'
        }

        const showTable=()=>{
            periodTable.style.display='block'
        }

        const clearFromTime=()=>{
            fromTime.value=''
        }

        const clearFromAll=()=>{
            fromAll.checked=''
        }

        const disableElements=()=>{
            nameTxt.disabled = true
            toReportOnDate.disabled = true
            ,fromAll.disabled = true
            ,fromTime.disabled = true
            ,destinationTxt.disabled = true
            ,reasonTxtArea.disabled = true
        }

        const setTimeLimitsOnTimePicker=(min,max)=>{
            fromTime.min=min
            fromTime.max=max
        }

        const validateTimeSelected=(e)=>{
            const time = event.target.value;

            console.log(time)
            console.log(event.target.min)
            console.log(event.target.max)

            if (time && (time < event.target.min || time > event.target.max)) {
                console.log('Outside Valid Range')
                event.target.setCustomValidity("Please select correct time between min and max");

                fromTime.classList.toggle("is-invalid", true);

                showAlertModal("Invalid Time",`Please choose time between ${event.target.min} and ${event.target.max}`)
            } else {
                console.log('Inside Valid Range')
                event.target.setCustomValidity("");
                fromTime.classList.toggle("is-invalid", false);
            }
        }

        const showAlertModal=(modalTitle,modalMessage)=>{
            alertModalTitle.textContent=modalTitle
            alertModalMessage.textContent=modalMessage
            alertModal.show()
        }

        const initSettings=()=>{
            requestorSignDiv.hidden= true // !allFieldsOk()
            // atPeriodSpan.textContent = periodTextDefault
            // fromAll.checked=false
            // fromTime.value=''
            periodTableBody.replaceChildren()
            hideTable()
            // requestorSignDiv.hidden=!allFieldsOk()
            
            fromTime.setCustomValidity('')
            fromTime.classList.toggle("is-invalid", false)
            requestorRequestorSignDiv.classList.add('d-none')
            requestorRequestorSignDiv.classList.remove("success-flash");
        }

        const allFieldsOk=()=>{
            console.log('Check Fields')
            console.log('nameTxt.value',nameTxt.value)
            console.log('gradeSpan.textContent',gradeSpan.textContent)
            console.log('toReportOnDate.value',toReportOnDate.value)
            console.log('atPeriodSpan.textContent',atPeriodSpan.textContent)
            
            console.log('fromAll.checked',fromAll.checked)
            console.log('fromTime.value',fromTime.value)
            console.log('destinationTxt.value',destinationTxt.value)
            console.log('reasonTxtArea.value',reasonTxtArea.value)

            console.log('fromTime.checkValidity()',fromTime.checkValidity())

            console.log('return Value',(nameTxt.value!=='' && gradeSpan.textContent!=='' && toReportOnDate.value!=='' && atPeriodSpan.textContent!==periodTextDefault
               && (fromAll.checked || fromTime.value!=='') && fromTime.checkValidity() && destinationTxt.value!=='' && reasonTxtArea.value!==''
            ))

            return (nameTxt.value!=='' && gradeSpan.textContent!=='' && toReportOnDate.value!=='' && atPeriodSpan.textContent!==periodTextDefault
               && (fromAll.checked || fromTime.value!=='') && fromTime.checkValidity() && destinationTxt.value!=='' && reasonTxtArea.value!==''
            )
        }

        const hideClearPeriodTable =() =>{
            periodTableBody.replaceChildren()
            hideTable()
        }

        initSettings()

    </script>
</body>
