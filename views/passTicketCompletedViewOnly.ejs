<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <!-- <script src="https://cdn.jsdelivr.net/npm/date-fns@2.30.0/cdn.min.js"></script> this version doesn't work with PARSE -->
    <script src="https://cdn.jsdelivr.net/npm/date-fns@4.1.0/cdn.min.js"></script>
</head>
<body>
    <style>
            .w-30 {
            width: 30%;
            }

            @media (max-width: 768px) {
                .w-30 {
                    width: 100%;
                }
            }

            #requestorRequestorSignDiv {
                background-color: transparent;
                border-color: transparent;
                color: inherit;
            }

            #receiverSignDiv {
                background-color: transparent;
                border-color: transparent;
                color: inherit;
            }           

            .success-flash {
                animation: successFlash 5s ease-in-out forwards;
            }

            @keyframes successFlash {
                0% {
                    background-color: transparent;
                    border-color: transparent;
                    color: inherit;
                }

                25%,
                65% {
                    background-color: #d1e7dd; /* Bootstrap alert-success background */
                    border-color: #a3cfbb;
                    color: #0f5132;             /* Bootstrap alert-success text */
                }

                100% {
                    background-color: transparent;
                    border-color: transparent;
                    color: inherit;
                }
            }
    </style>
    <script>
        const inMode=0
        const regex = /\[([^\]]*)\]/g;
    </script>


    <div>&nbsp;</div>
    
    <div class="container mt-3">
        <div class="h2 text-center">ʻIOLANI SCHOOL STUDY HALL EXCUSE</div>
        <div class="h2 text-center">(Closed)</div>
        <form class="row g-3 mt-3">
            <div class="">
            Please excuse <input id="nameTxt" class="form-select form-select-sm text-danger w-auto d-inline-block" aria-describedby="name-desc"  list="nameTxtList" placeholder="LastName, FirstName" type="text" name="nameTxt" value="" disabled>
            <datalist id="nameTxtList"></datalist>
                , grade <span id="gradeSpan" class="text-danger"><%= data.grade %></span>,


                on <input id="toReportOnDate" type="date" class="form-control text-danger w-auto d-inline-block" value=<%= data.displayAtDate %> disabled />
                <!-- period <input id="atPeriodSpan"  class="form-control form-control-sm text-danger w-auto d-inline-block" placeholder="Select Period From Table" /> -->
                Period <span id="atPeriodSpan" class="text-danger"><%= data.on_period %></span><span id="atClintRecId" hidden></span>
                Study Hall


    <div class="d-flex align-items-center gap-2 flex-wrap">
        <fieldset class="border border-secondary rounded p-3 w-30">
        <legend class="float-none w-auto px-2 fs-6 mb-0">
            From
        </legend>
        <div class="d-flex align-items-center gap-3">

            <!-- All option -->
            <div class="form-check">
            <input
                id="fromAll"
                class="form-check-input"
                type="radio"
                name="fromAll"
                value="All"
                <%= data.duration==='A'?'checked':'' %>
                disabled
            >
            <label class="form-check-label" for="fromAll">
                All
            </label>
            </div>

            <!-- Separator -->
            <span class="fw-bold text-muted">OR</span>

            <!-- Time option -->
            <div>
            <input id="fromTime" type="time" class="form-control" name="fromTime" min="08:00" max="15:00" step="60" value="<%= (data.displayAtTime?data.displayAtTime:'') %>" disabled />
            </div>
        </div>
        </fieldset>
    
            to report to <input id="destinationTxt" type="text" class="form-control form-control-sm text-danger" placeholder="destination to report to" style="width: 220px;"  value='<%= ((typeof data.report_to ==='undefined')?'':data.report_to) %>' disabled />
            <!-- for -->


                    <div class="input-group">
                        <span class="input-group-text">Reason</span>
                        <textarea id="reasonTxtArea" class="form-control text-danger" maxlength="100" aria-label="With textarea" disabled ><%= data.reason %></textarea>
                    </div>
                </div>


            </div>

    <div id="requestorSignDiv" class="col-md-6">
        Requestor: 
            <div id="requestorRequestorSignDiv" class="alert alert-success d-inline-flex align-items-center gap-2 mb-0 py-1 px-2" role="alert">
                <span id="requestorSignSpan" class="text-danger"><%= data.requestorDisplay %></span> <span id="requestorSignDateSpan" class="text-danger"><%= data.requestorSignedDisplay %></span>
            </div>
    </div>

  <hr/>


    <div>Student reported at <input id="reportedAtTime" type="time" class="form-control text-danger w-auto d-inline-block" value="<%= data.reportedAtTimeDisplay %>" disabled /> and departed at <input id="departedAtTime" type="time" class="form-control text-danger w-auto d-inline-block" value="<%= data.departedAtTimeDisplay %>" disabled /> </div>

    <div id="receiverSignDiv" class="col-md-6">
        Fac/Staff: 
            <div id="receiverReceiverSignDiv" class="alert alert-success d-inline-flex align-items-center gap-2 mb-0 py-1 px-2" role="alert">
                <span id="receiverSignSpan" class="text-danger"><%= data.receiverDisplay %></span> <span id="receiverSignDateSpan" class="text-danger"><%= data.receiverSignedDisplay %></span>
            </div>
    </div>

</form>


    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <!-- <script src ="./js/tools.js"></script> -->
 
</body>
</html>