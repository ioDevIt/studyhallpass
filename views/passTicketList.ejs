<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"> -->
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/tachyons@4.12.0/css/tachyons.min.css"/>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
    <style>
        .thinking-splash {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.8);
            }

        .thinking-box {
            padding: 1.5rem 2rem;
            text-align: center;
            background: white;
            border-radius: 0.5rem;
            box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.2);
            font-size: 1.25rem;
            color: #333;
            }

        .d-none {
            display: none !important;
            }
    </style>
</head>
<body>
    <!-- Splash screen -->
    <div id="thinkingSplash" class="thinking-splash d-none">
    <div class="thinking-box">
        <div id="thinkingText">thinking</div>
        <div class="spinner-border spinner-border-sm mt-2"></div>
    </div>
    </div>
    <!-- Alert Modal -->
    <div id="modal" class="dn fixed top-0 left-0 w-100 h-100 bg-black-50 items-center justify-center">
    <div class="bg-white pa4 br3 shadow-5">
        <h2 id="modalTitle" class="f4">Modal Title</h2>
        <p  id="modalText" >Your content goes here.</p>

        <button id="closeModal" class="f6 link dim br2 ph3 pv2 mb2 dib white bg-red">
        Close
        </button>
    </div>
    </div>

    <div class="cf">
        <div class="fl w-5 w-10-ns tc pv5"></div>
        <div class="fl w-100 w-80-ns tc pv5">
            <header class="bg-white black-80 tc pv4 avenir">
                <h1 class="mt2 mb0 baskerville i fw1 f1"><%= title %></h1>
                <h2 class="mt2 mb0 f6 fw4 ttu tracked"><%= subtitle %></h2>
                <nav class="bt bb tc center mt4">
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/createPass">Create Pass</a>
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/listmystudentspassestoday">Todays Passes For My Students</a>
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/listmystudentspasses">Passes For My Students</a>
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/listmypasses">View My Passes</a>
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/listtodays">View Todays Passes</a> 
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-lightest-blue dib pa3 ph4-l" href="/listallopen">View All Open Passes</a> <!-- only for counselors and admin -->
                    <a class="f6 f5-l link bg-animate black-80 hover-bg-light-yellow dib pa3 ph4-l" href="/logout">Logout</a>
                </nav>
            </header>
            <div class="pa4">
            <div class="overflow-auto">
                <table class="f6 w-100 mw8 center" cellspacing="0">
                    <thead>
                        <tr class="stripe-dark">
                        <th class="fw6 tl pa3 bg-white">Date</th>
                        <th class="fw6 tl pa3 bg-white">Period</th>
                        <th class="fw6 tl pa3 bg-white">Name</th>            
                        <th class="fw6 tl pa3 bg-white">Report To</th>
                        <th class="fw6 tl pa3 bg-white">Reason</th>
                        <th class="fw6 tl pa3 bg-white">Duration</th>
                        <th class="fw6 tl pa3 bg-white">Status</th>
                        <th class="fw6 tl pa3 bg-white">Requestor</th>
                        <th class="fw6 tl pa3 bg-white">Pass #</th>
                        <th class="fw6 tl pa3 bg-white"></th>
                        <th class="fw6 tl pa3 bg-white"></th>
                        <th class="fw6 tl pa3 bg-white"></th>
                        </tr>
                    </thead>
                    <tbody id="mainTBody">
                        <% displayPasses.forEach((r)=>{ %>
                        <% if(isOnlyMyPasses){ %>
                            <tr id=<%= `row_${r.pt_id}` %> class="stripe-dark" >
                         <% } else { %>
                            <tr id=<%= `row_${r.pt_id}` %> class="stripe-dark" >
                         <% } %>
                        
                            <td id=<%= `row_displayDate_${r.pt_id}` %> class="tl pa3"><%= r.displayDate %></td>
                            <td id=<%= `row_period_${r.pt_id}` %> class="tl pa3"><%= r.period %></td>
                            <td id=<%= `row_displayName_${r.pt_id}` %> class="tl pa3"><%= `${r.pname} ${r.lname}` %></td>            
                            <td id=<%= `row_reportTo_${r.pt_id}` %> class="tl pa3"><%= r.report_to %></td>
                            <td id=<%= `row_reason_${r.pt_id}` %> class="tl pa3"><%= r.reason %></td>
                            <td id=<%= `row_duration_${r.pt_id}` %> class="tl pa3"><%= (r.duration==='A'?r.displayDuration:r.displayDuration) %></td>
                            <td id=<%= `row_status_${r.pt_id}` %> class="tl pa3"><%= r.pt_status %></td>
                            <td id=<%= `row_requestor_${r.pt_id}` %> class="tl pa3"><a href="mailto:<%= r.requestor %>"><%= r.requestor %></a></td>
                            <td id=<%= `row_ptid_${r.pt_id}` %> class="tl pa3"><%= r.pt_id %></td>
                            <td id=<%= `row_viewsvg_${r.pt_id}` %> class="tl pa3" onclick="(e)=>{event.preventDefault(); event.stopPropagation(); console.log('Clicked')}" >
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-upload" viewBox="0 0 16 16"  onclick=viewPass(event,<%= r.pt_id %>)>
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z"/>
                                </svg>
                            </td>
                            <td id=<%= `row_editsvg_${r.pt_id}` %> class="tl pa3" onclick="(e)=>{event.preventDefault(); event.stopPropagation(); console.log('Clicked')}" >
                                <% if(r.allowEdit){ %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16" onclick=editPass(event,<%= r.pt_id %>)>
                                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                                </svg>
                                <% } %>
                            </td>
                            <td id=<%= `row_deletesvg_${r.pt_id}` %> class="tl pa3">
                                <% if(r.allowDelete){ %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16" onclick="deletePass(event,<%= r.pt_id %>)"> 
  <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
  <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
</svg>
                                <% } %>      
                            </td>                            
                        </tr>
                        <% })  %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script> -->
    <!-- <script src ="./js/tools.js"></script> -->


    <script>
        const viewPass=(e,thisPassId)=>{
            e.preventDefault();
            e.stopPropagation();
            window.open(`/viewPass/${thisPassId}`, '_blank')
        }

        const completePass=(thisPassId)=>{
            window.open(`/completePass/${thisPassId}`, '_blank')
        }

        const editPass=(e,thisPassId)=>{
            e.preventDefault();
            e.stopPropagation();
            window.open(`/editPass/${thisPassId}`, '_blank')
        }

        const deletePass=(e,thisPassId)=>{
            e.preventDefault();
            e.stopPropagation();
            showThinking('eating',4)
            const postid="?"
                const rsConfig={headers:{"X-XSRF-TOKEN":postid},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

                axios.post('/deletePass',{
                    search:new Date(),
                    thisPassId:thisPassId,
                    postid:postid
                },rsConfig).then((rsp)=>{                   
                    const rspData = rsp.data

                    console.log('rsp',rsp)
                    console.log('rspData',rspData)

                    // setTable(periodTableBody,rspData)
                    // showTable()
                    // allFieldsOk()
                    hideThinking()

                    if(rspData.status=='Ok'){
                        document.getElementById(`row_${thisPassId}`).remove()
                    }
                    else{
                        showAlertModal('Delete Issue',`Could Not Delete Pass #${thisPassId}`)
                    }
                })
                .catch((e)=>{console.log(e);hideThinking()})
                .finally(()=>{
                    hideThinking()
                })
        }
    </script>

    <script>
        const mainTBody = document.getElementById('mainTBody')
        const modal = document.getElementById('modal')
        const closeModal=document.getElementById('closeModal')
        const modalTitle = document.getElementById('modalTitle')
        const modalText = document.getElementById('modalText')

        modal.classList.add("dn");

        const showAlertModal=(thisModalTitle,thisModalMessage)=>{
            modalTitle.textContent = thisModalTitle
            modalText.textContent = thisModalMessage
            // modal.classList.remove("dn");
            modal.classList.add("flex");
        }

        const hideAlertModal=()=>{
            modal.classList.remove("flex")
        }

        closeModal.addEventListener('click',hideAlertModal)
        modal.addEventListener('click',hideAlertModal)
    </script>

    <script>
         const splash = document.getElementById("thinkingSplash")
        let thinkingTimer;        

        const showThinking = (startingWord,numofPauseDots) => {
        const thisStartingWord = (startingWord?startingWord:'thinking')
        const thisNumOfPauseDots = (numofPauseDots?numofPauseDots:6)
        let thinkingDots = 0
        splash.classList.remove("d-none");

        thinkingDots = 0;
        thinkingText.textContent = thisStartingWord;

        thinkingTimer = setInterval(() => {
            thinkingDots = (thinkingDots + 1) % thisNumOfPauseDots;
            thinkingText.textContent = `${thisStartingWord}${".".repeat(thinkingDots)}`;
        }, 500);
        };

        const hideThinking = () => {
        clearInterval(thinkingTimer);
        splash.classList.add("d-none");
        };

        const initSettings=()=>{
            hideAlertModal()
        }

        initSettings()
        
    </script>


    <script>
        const createViewIconCell = (passId) => {
            const thisTD = document.createElement('td')
            thisTD.id=`row_editsvg_${passId}` 
            thisTD.classList.add('tl','pa3')

            const svgNS = 'http://www.w3.org/2000/svg';

            const svg = document.createElementNS(svgNS, 'svg');
            svg.setAttribute('xmlns', svgNS);
            svg.setAttribute('width', '16');
            svg.setAttribute('height', '16');
            svg.setAttribute('fill', 'currentColor');
            svg.setAttribute('class', 'bi bi-pencil-square');
            svg.setAttribute('viewBox', '0 0 16 16');

            svg.addEventListener('click', (e) => {
                viewPass(e,passId);
            });

            const path1 = document.createElementNS(svgNS, 'path');
            path1.setAttribute(
                'd',
                'M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5'
            );

            const path2 = document.createElementNS(svgNS, 'path');
            path2.setAttribute('fill-rule', 'evenodd');
            path2.setAttribute(
                'd',
                'M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z'
            );

            svg.append(path1, path2);

            thisTD.append(svg)
            return thisTD;
        }

        const createEditIconCell = (passId) => {
            const thisTD = document.createElement('td')
            thisTD.id=`row_editsvg_${passId}` 
            thisTD.classList.add('tl','pa3')

            const svgNS = 'http://www.w3.org/2000/svg';

            const svg = document.createElementNS(svgNS, 'svg');
            svg.setAttribute('xmlns', svgNS);
            svg.setAttribute('width', '16');
            svg.setAttribute('height', '16');
            svg.setAttribute('fill', 'currentColor');
            svg.setAttribute('class', 'bi bi-pencil-square');
            svg.setAttribute('viewBox', '0 0 16 16');

            svg.addEventListener('click', (e) => {
                editPass(e,passId);
            });

            const path1 = document.createElementNS(svgNS, 'path');
            path1.setAttribute(
                'd',
                'M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z'
            );

            const path2 = document.createElementNS(svgNS, 'path');
            path2.setAttribute('fill-rule', 'evenodd');
            path2.setAttribute(
                'd',
                'M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z'
            );

            svg.append(path1, path2);

            thisTD.append(svg)
            return thisTD;
        }

        const createDeleteIconCell = (passId) => {
            const thisTD = document.createElement('td')
            thisTD.id=`row_deletesvg_${passId}` 
            thisTD.classList.add('tl','pa3')

            const svgNS = 'http://www.w3.org/2000/svg';

            const svg = document.createElementNS(svgNS, 'svg');

            svg.setAttribute('xmlns', svgNS);
            svg.setAttribute('width', '16');
            svg.setAttribute('height', '16');
            svg.setAttribute('fill', 'currentColor');
            svg.setAttribute('class', 'bi bi-trash');
            svg.setAttribute('viewBox', '0 0 16 16');

            svg.addEventListener('click', (e) => {
                deletePass(e,passId);
            });

            const path1 = document.createElementNS(svgNS, 'path');
            path1.setAttribute(
                'd',
                'M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z'
            );

            const path2 = document.createElementNS(svgNS, 'path');
            path2.setAttribute(
                'd',
                'M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z'
            );

            svg.append(path1, path2);

            thisTD.append(svg)

            return thisTD;
        }


        const makeEmailCell = (idName,email,textContent) =>{
            const thisTD = document.createElement('td')
            thisTD.id = idName
            thisTD.classList.add('tl','pa3')
            const thisAnc = document.createElement('a')
            thisAnc.href = `mailto:${email}`
            thisAnc.textContent=textContent

            thisTD.append(thisAnc)

            return thisTD
        }

        const makeTDCell = (idName,textContent) =>{
            const thisTD = document.createElement('td')
            thisTD.id = idName
            thisTD.classList.add('tl','pa3')
            thisTD.textContent=textContent

            return thisTD
        }

        const updateCell =(id,textContent)=>{
            const updateTD = document.getElementById(id)
            if(updateTD){
                updateTD.textContent=textContent
            }
        }

        const removeCellIcon =(id)=>{
            const thisTD = document.getElementById(id)
            if(thisTD){
                thisTD.innerHTML=''
            }
        }

        const addNewRow =(msg)=>{
            const newTR = document.createElement('tr')
            newTR.id = `row_${msg.value.pt_id}`
            newTR.classList.add('stripe-dark','passrow')
            
            <% if(isOnlyMyPasses){ %>
                newTR.addEventListener('click',completePass(msg.value.pt_id))
            <% } else { %>
                newTR.addEventListener('click',viewPass(event,msg.value.pt_id))
            <% } %>

            newTR.append(makeTDCell(`row_displayDate_${msg.value.pt_id}`,msg.value.atDateDisplay))
            newTR.append(makeTDCell(`row_period_${msg.value.pt_id}`, msg.value.on_period))
            newTR.append(makeTDCell(`row_displayName_${msg.value.pt_id}`, `${msg.value.pname} ${msg.value.lname}`))
            newTR.append(makeTDCell(`row_reportTo_${msg.value.pt_id}`, msg.value.report_to))
            newTR.append(makeTDCell(`row_reason_${msg.value.pt_id}`, msg.value.reason))
            newTR.append(makeTDCell(`row_duration_${msg.value.pt_id}`, (msg.value.duration==='A'?msg.value.duration:msg.value.atTimeDisplay)))
            newTR.append(makeTDCell(`row_status_${msg.value.pt_id}`,msg.value.pt_status))
            newTR.append(makeEmailCell(`row_requestor_${msg.value.pt_id}`,msg.value.requestor,msg.value.requestor))
            newTR.append(makeTDCell(`row_ptid_${msg.value.pt_id}`,msg.value.pt_id))
            newTR.append(createViewIconCell(msg.value.pt_id))
            newTR.append(createEditIconCell(msg.value.pt_id))
            newTR.append(createDeleteIconCell(msg.value.pt_id))

            console.log('Adding Passes')
            mainTBody.append(newTR)
        }

        const deleteRow =(msg)=>{
            const deleteRowBtn = document.getElementById(`row_${msg.value.id}`)

            if(deleteRowBtn){
                deleteRowBtn.remove()
            }
        }

        const updateRow = (msg) =>{
                updateCell(`row_displayDate_${msg.value.pt_id}`,`${msg.value.atDateDisplay}`)
                updateCell(`row_period_${msg.value.pt_id}`,`${msg.value.on_period}`)
                updateCell(`row_reportTo_${msg.value.pt_id}`,`${msg.value.report_to}`)
                updateCell(`row_reason_${msg.value.pt_id}`,`${msg.value.reason}`)
                updateCell(`row_duration_${msg.value.pt_id}`,(msg.value.duration==='A'?msg.value.duration:msg.value.atTimeDisplay))
        }
        
        const completeRow = (msg)=>{
            console.log(`row_status_${msg.value.pt_id}`,'Cmp')
            updateCell(`row_status_${msg.value.pt_id}`,'Cmp')
            removeCellIcon(`row_editsvg_${msg.value.pt_id}`)
            removeCellIcon(`row_deletesvg_${msg.value.pt_id}`)
            
            // document.getElementById(`row_editsvg_${msg.value.pt_id}`).innerHTML=''
            // document.getElementById(`row_deletesvg_${msg.value.pt_id}`).innerHTML=''
        }

        const socket = io()

         socket.on('PassList',(msg)=>{
           console.log('Received this Message','PassList',msg)
           const val=msg.value

           <% if(isOnlyToday){ %>
           if(val.isToday){ 
            if(msg.action === 'new'){
                    addNewRow(msg)
            } else if(msg.action === 'delete'){
                    deleteRow(msg)
            } else if(msg.action === 'update'){
                    updateRow(msg)
            } else if(msg.action === 'cmp'){
                    completeRow(msg)
            }
           } else {
                if(msg.action === 'update'){
                    deleteRow(msg)
                }
           }
           <% } else { %>
            if(msg.action === 'new'){
                    addNewRow(msg)
            } else if(msg.action === 'delete'){
                    deleteRow(msg)
            } else if(msg.action === 'update'){
                    updateRow(msg)
            } else if(msg.action === 'cmp'){
                    completeRow(msg)
            }
           <% } %>
         })
    </script>

</body>
</html>