<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
</head>
<body>
    <script>
        const cuser='<%= user%>';
        const inMode=0
        const regex = /\[([^\]]*)\]/g;
    </script>
    
    <div class="container mt-3">
        <div class="h2 text-center">ʻIOLANI SCHOOL STUDY HALL EXCUSE</div>
        <form class="row g-3 mt-3">
            <div class="">
                Please excuse <input id="nameTxt" class="form-select form-select-sm text-danger w-auto d-inline-block" aria-describedby="name-desc"  list="nameTxtList" placeholder="LastName, FirstName" type="text" name="nameTxt" value="" <%= (mode!=='Request'?'disabled':'') %> >
            <datalist id="nameTxtList"></datalist>
                , grade <span id="gradeSpan" class="text-danger"><%= ( typeof grade=='undefined'?'[grade]':grade) %></span>,
                from
                    <select id="forDurationSelect" class="form-select form-select-sm text-danger w-auto d-inline-block" aria-label="for duration" <%= (mode!=='Request'?'disabled':'') %> >
                        <option selected value="all">All</option>
                        <option value="part">Part</option>
                    </select>

                of their period 
                    <select id="forPeriodSelect" class="form-select form-select-sm text-danger w-auto d-inline-block" aria-label="" <%= (mode!=='Request'?'disabled':'') %> value=1 >
                        <option value="0">0HR</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                    </select>

                study hall on <input id="toReportOnDate" type="date" class="form-control text-danger w-auto d-inline-block" <%= (mode!=='Request'?'disabled':'') %> value=<%= ((typeof displayDate ==='undefined')?'':displayDate) %> /> to report 
                to <input id="destinationTxt" type="text" class="form-control form-control-sm text-danger w-auto d-inline-block" placeholder="destination to report to" <%= (mode!=='Request'?'disabled':'') %> value=<%= ((typeof reportto ==='undefined')?'':reportto) %> />
                for

                <div class="input-group">
                    <span class="input-group-text">Reason</span>
                    <textarea id="reasonTxtArea" class="form-control text-danger" maxlength="100" aria-label="With textarea" <%= (mode!=='Request'?'disabled':'') %>><%= ((typeof reason ==='undefined')?'':reason) %></textarea>
                </div>
            </div>

  <div class="col-md-6">
     Requestor:             <% if(mode==='Request'){ %><button id="requestorBtn" type="button" class="btn btn-primary btn-sm">Sign</button><% } %>
     <span id="requestorSignSpan" class="text-danger"></span> <span id="requestorSignDateSpan" class="text-danger"></span>
     <input id="requestorSignInput" class="text-danger" name="requestorSignInput" hidden></input><input id="requestorSignDateInput" class="text-danger" name="requestorSignDateInput" hidden></input>
  </div>

  <hr/>

  <% if(mode==='Receive' || mode==='Completed'){ %>
  <div>Student reported at <input id="reportedAtTime" type="time" class="form-control text-danger w-auto d-inline-block" <%= (mode!=='Receive'?'disabled':'') %> /> and departed at <input id="departedAtTime" type="time" class="form-control text-danger w-auto d-inline-block" <%= (mode!=='Receive'?'disabled':'') %> /> </div>


  <div>
    Fac/Staff: <span id="receiverSignSpan" class="text-danger"></span> <span id="receiverSignDateSpan" class="text-danger"></span>
    <input id="receiverSignInput" class="text-danger" name="receiverSignInput" hidden></input><input id="receiverSignDateInput" class="text-danger" name="receiverSignDateInput" hidden></input>
    <button id="receiverBtn" type="button" class="btn btn-primary btn-sm" <%= (mode==='Completed'?'hidden':'')  %>  >Sign</button>
  </div>

  <% } %>
</form>

  <button id="testBtn">test</button>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <script src ="./js/tools.js"></script>
    <script>
        let currentSelectionList={};

        const setNewValues=(theseValues)=>{
          currentSelectionList = {}
          nameTxtList.innerHTML="";

          theseValues.forEach((thisRow)=>{
            console.log('thisRow',thisRow)
            let newEl=document.createElement('option')
            newEl.value =  `${thisRow.lname}, ${thisRow.fname} (${thisRow.uid}) [${thisRow.grade}]`
            // newEl.textContent = thisRow.lname
            newEl.dataset.uid = thisRow.uid

            currentSelectionList[thisRow.uid]=thisRow

            nameTxtList.append(newEl)
          })
        }
    </script>
    <script>

        const gradeSpan= document.getElementById('gradeSpan')
        const forDurationSelect= document.getElementById('forDurationSelect')
        const forPeriodSelect= document.getElementById('forPeriodSelect')
        const destinationTxt= document.getElementById('destinationTxt')
        const toReportOnDate= document.getElementById('toReportOnDate')
        const reasonTxtArea= document.getElementById('reasonTxtArea')
        const requestorSignSpan= document.getElementById('requestorSignSpan')
        const requestorSignDateSpan= document.getElementById('requestorSignDateSpan')
        
        
        const requestorBtn= document.getElementById('requestorBtn')

        const reportedAtTime= document.getElementById('reportedAtTime')
        const departedAtTime= document.getElementById('departedAtTime')
        const receiverSignSpan= document.getElementById('receiverSignSpan')
        const receiverSignDateSpan= document.getElementById('receiverSignDateSpan')
        const receiverBtn= document.getElementById('receiverBtn')

        const nameTxt=document.getElementById('nameTxt')



        const sendRequestData=()=>{
          let sendData = {
            forName:nameTxt.value
            ,grade:gradeSpan.textContent
            ,duration:forDurationSelect.value
            ,period:forPeriodSelect.value
            ,onDate:toReportOnDate.value
            ,reportTo:destinationTxt.value
            ,reason:reasonTxtArea.value
          };
          
          console.log('test')// Some reason this is neede
          console.log(sendData)


        const cxData ="TEST"
          
          if(true) // later add checks
            {
              const rsConfig={headers:{"X-XSRF-TOKEN":cxData},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

              axios.post('/passTicket/new',{
                search:sendData
              },rsConfig).then((rsp)=>{
                let thisData=rsp.data.rspData[0]
                let thisStatus=rsp.data.status
                let thisMessage = rsp.data.message

                console.log('rsp', rsp.data)
                console.log('rsp.data', thisData)
                console.log(thisMessage)


                requestorSignSpan.textContent=cuser
                requestorSignDateSpan.textContent=thisData.displayDate
              })
              .catch((e)=>{console.log(e)})
            }
        }



        const setInRequestorMode=()=>{
            forDurationSelect.disabled=false
            forPeriodSelect.disabled=false
            toReportOnDate.disabled=false
            destinationTxt.disabled=false
            reasonTxtArea.disabled=false
            requestorBtn.disabled=false
            requestorBtn.hidden=false
        }

        const setInReceiverMode=()=>{
            reportedAtTime.disabled=false
            departedAtTime.disabled=false
        }

        const setInClosedMode=()=>{
            setInRequestorMode()
            setInReceiverMode()
        }

        const signDocRequestor=()=>{
            console.log('Will Sign')
            requestorSignSpan.textContent=cuser
            requestorSignDateSpan.textContent=signedAtHST()
            setRequestorAndReceiverBtn()      
        }

        const signDocReceiver = ()=>{
            console.log('signDocReceiver')
            receiverSignSpan.textContent=cuser
            receiverSignDateSpan.textContent=signedAtHST()        
            setRequestorAndReceiverBtn()        
        }


        const shouldHideRequestorBtn =() =>{
            console.log('toReportOnDate.value',toReportOnDate.value)
            return ((toReportOnDate.value==="") || (destinationTxt.value ==="") || (reasonTxtArea.value ==="") || (requestorSignSpan.textContent !=="") )
        }

        const shouldHideReceiverBtn =() =>{
              return ((reportedAtTime.value ==="") || (departedAtTime.value ==="") || (receiverSignSpan.textContent !==""))
        }

        const setRequestorAndReceiverBtn=()=>{
            <% if(mode==='Request'){ %>
            requestorBtn.hidden=shouldHideRequestorBtn()
            <% } %>

            <% if(mode==='Receive'){ %>
            receiverBtn.hidden=shouldHideReceiverBtn()
            <% } %>
        }



        <% if(mode==='Request'){ %>
        /**** Request ****/
            gradeSpan.addEventListener('change',setRequestorAndReceiverBtn)
            forDurationSelect.addEventListener('change',setRequestorAndReceiverBtn)
            toReportOnDate.addEventListener('change',setRequestorAndReceiverBtn)
            destinationTxt.addEventListener('input',setRequestorAndReceiverBtn)
            reasonTxtArea.addEventListener('input',setRequestorAndReceiverBtn)


            requestorBtn.addEventListener('click',sendRequestData)  // signDocRequestor
        <% } %>


        /**** Receive ****/
        <% if(mode==='Receive'){ %>
            reportedAtTime.addEventListener('change',setRequestorAndReceiverBtn)
            departedAtTime.addEventListener('change',setRequestorAndReceiverBtn)

            receiverBtn.addEventListener('click',signDocReceiver)
       <% } %>

        setRequestorAndReceiverBtn()

        nameTxt.addEventListener('keyup',(e)=>{
          let thiskeyCode = nameTxt.value;
          const postid="?"
          const rsConfig={headers:{"X-XSRF-TOKEN":postid},withXSRFToken:true,xsrfHeaderName: 'X-XSRF-TOKEN', responseType:'json' }

          console.log('thiskeyCode',thiskeyCode)
          axios.post('/getPassStudentList',{
            search:thiskeyCode,
            postid:postid
          },rsConfig).then((rsp)=>{
            console.log('rsp',rsp)
            const rspData = rsp.data

            console.log('rspData',rspData)
            

            setNewValues(rspData)

          })
          .catch((e)=>{console.log(e)})
        })


        nameTxt.addEventListener('change',()=>{
            const thisValue = nameTxt.value
            const matches = [...thisValue.matchAll(regex)].map(m => m[1]); 

            if(matches.length>0){gradeSpan.textContent=matches[0]}

            console.log('matches',matches)
        })



    const testBtn = document.getElementById('testBtn')

    testBtn.addEventListener('click',()=>{
        sendRequestData()
    })


    /************ To Test ***************/
    const testObj =  {
    "forName": "Meaney, Brynn (BAM3101@iolani.org) [8]",
    "grade": "8",
    "duration": "all",
    "onDate": "2026-06-30",
    "reportTo": "test",
    "reason": "reason"
        }

    nameTxt.value= testObj.forName
    gradeSpan.textContent=testObj.grade
    </script>
</body>
</html>