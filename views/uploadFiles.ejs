<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="stylesheet" href="https://unpkg.com/tachyons@4.12.0/css/tachyons.min.css"/>
</head>
<body>
    <header class="tc ph4 pv5">
        <h1 class="f3 f2-m f1-l pv-3 fw2 black-90 mv3">Welcome</h1>
        <h2 class="f5 f4-m f3-l fw2 black-50 mt0 lh-copy">
          <% if(typeof(Glogin)!=='undefined'){ %>   
                <a href="/auth/google">G Login</a>
          <% } %>
          <% if(typeof(Vlogin)!=='undefined'){ %>   
                <a href="/auth/veracross">V Login</a>
          <% } %>
          <% if(typeof(logout)!=='undefined'){ %>   
                <a href="/logout">Logout</a>
          <% } %>
        </h2>
        <h2 class="f5 f4-m f3-l fw2 black-50 mt0 lh-copy">
          <% if(typeof(message)!=='undefined'){ %>   
                <%= message %>
          <% } %>
        </h2>
    </header>

        <div class="cf">
        <div class="fl w-10 tc pv5"></div>
        <div class="fl w-80 tc pv5">
            <form id="mainFrm" action="/sample/upload" method="post" enctype="multipart/form-data">
                <input type="text" name="postid" value="<%= postid %>"/>
                <input type="file" name="profileImage" multiple />
                <button class="f6 link dim br2 ba bw1 ph3 pv2 mb2 dib mid-gray"type="submit">Upload File</button>
            </form>
        </div>
        <div class="fl w-10 tc pv5"></div>
        </div>
</body>
</html>